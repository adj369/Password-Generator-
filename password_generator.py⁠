# Mini Project: Password Generator and Strength Checker
# Concepts used: random module, strings, lists, loops, if-else, functions

import random

# Character sets written manually for easy understanding
lowercase_letters = "abcdefghijklmnopqrstuvwxyz"
uppercase_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
numbers = "0123456789"
symbols = "!@#$%^&*?"

# List to store passwords generated in this session
password_history = []


def generate_password():
    print("\n--- Generate a Custom Password ---")
    length = int(input("Enter password length (minimum 6): "))
    
    if length < 6:
        print("Password is too short! Setting length to 6 by default.")
        length = 6

    include_upper = input("Include uppercase letters? (y/n): ").strip().lower()
    include_nums = input("Include numbers? (y/n): ").strip().lower()
    include_syms = input("Include special symbols? (y/n): ").strip().lower()

    # Start with lowercase letters by default
    allowed_chars = lowercase_letters

    if include_upper == "y":
        allowed_chars = allowed_chars + uppercase_letters
    if include_nums == "y":
        allowed_chars = allowed_chars + numbers
    if include_syms == "y":
        allowed_chars = allowed_chars + symbols

    # Building the password character by character using a loop
    new_password = ""
    for i in range(length):
        random_char = random.choice(allowed_chars)
        new_password = new_password + random_char

    print("\n------------------------------------------")
    print(f"Your Generated Password: {new_password}")
    print("------------------------------------------")

    # Ask user if they want to save it with a label (e.g., Instagram, Gmail)
    save_choice = input("Save this password to session history? (y/n): ").strip().lower()
    if save_choice == "y":
        account_name = input("Enter account/app name (e.g., Gmail, WiFi): ").strip().title()
        entry = f"{account_name}: {new_password}"
        password_history.append(entry)
        print("Saved to history successfully!")


def check_strength():
    print("\n--- Check Password Strength ---")
    user_pwd = input("Enter a password to test its strength: ").strip()

    if len(user_pwd) == 0:
        print("You did not enter anything!")
        return

    # Flags to check what types of characters are present
    has_lower = False
    has_upper = False
    has_num = False
    has_sym = False

    # Checking each character one by one
    for ch in user_pwd:
        if ch in lowercase_letters:
            has_lower = True
        elif ch in uppercase_letters:
            has_upper = True
        elif ch in numbers:
            has_num = True
        else:
            has_sym = True

    # Calculating strength score out of 5
    score = 0
    if len(user_pwd) >= 8:
        score += 1
    if has_lower:
        score += 1
    if has_upper:
        score += 1
    if has_num:
        score += 1
    if has_sym:
        score += 1

    print(f"\nPassword Length: {len(user_pwd)} characters")
    print(f"Security Score: {score}/5")

    if score <= 2:
        print("Strength: WEAK (Easy to guess! Try adding numbers and symbols.)")
    elif score == 3 or score == 4:
        print("Strength: MEDIUM (Good, but can be stronger.)")
    else:
        print("Strength: STRONG (Great password!)")


def view_history():
    print("\n--- Saved Passwords (Current Session) ---")
    if len(password_history) == 0:
        print("No passwords saved yet. Generate one first!")
        return

    for i in range(len(password_history)):
        print(f"{i + 1}. {password_history[i]}")


# Main Menu Loop
def main():
    print("==========================================")
    print("   PYTHON PASSWORD GENERATOR & CHECKER    ")
    print("==========================================")

    while True:
        print("\nMAIN MENU:")
        print("1. Generate a New Password")
        print("2. Check Password Strength")
        print("3. View Saved Passwords")
        print("4. Exit")

        choice = input("\nEnter your choice (1-4): ").strip()

        if choice == "1":
            generate_password()
        elif choice == "2":
            check_strength()
        elif choice == "3":
            view_history()
        elif choice == "4":
            print("\nExiting program... Stay safe online!")
            break
        else:
            print("\nInvalid input! Please enter 1, 2, 3, or 4.")


# Run the program
main()
